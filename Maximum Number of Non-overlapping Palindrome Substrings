class Solution {
    public int maxPalindromes(String s, int k) {
        int n = s.length();

        // palindrome[i][j] = true if s[i...j] is a palindrome
        boolean[][] palindrome = new boolean[n][n];

        // Length 1
        for (int i = 0; i < n; i++) {
            palindrome[i][i] = true;
        }

        // Length 2 to n
        for (int len = 2; len <= n; len++) {
            for (int i = 0; i + len <= n; i++) {
                int j = i + len - 1;

                if (s.charAt(i) == s.charAt(j)) {
                    if (len == 2) {
                        palindrome[i][j] = true;
                    } else {
                        palindrome[i][j] = palindrome[i + 1][j - 1];
                    }
                }
            }
        }

        // dp[i] = maximum number of palindromes in s[0...i]
        int[] dp = new int[n];

        for (int i = 0; i < n; i++) {

            // Don't use s[i] in a palindrome
            dp[i] = (i > 0) ? dp[i - 1] : 0;

            // Try every palindrome ending at i
            for (int j = 0; j <= i; j++) {

                if (i - j + 1 >= k && palindrome[j][i]) {

                    int previous = (j > 0) ? dp[j - 1] : 0;

                    dp[i] = Math.max(dp[i], previous + 1);
                }
            }
        }

        return dp[n - 1];
    }
}
