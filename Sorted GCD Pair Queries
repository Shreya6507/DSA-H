class Solution {
    public int[] gcdValues(int[] nums, long[] queries) {
        int max = 1;
        for (int num : nums) {
            max = Math.max(max, num);
        }

        long[] gcdDp = new long[max + 1];

        // Frequency of each number
        for (int num : nums) {
            gcdDp[num]++;
        }

        // Count pairs whose gcd is divisible by i
        for (int i = 1; i <= max; i++) {
            long count = 0;
            for (int j = i; j <= max; j += i) {
                count += gcdDp[j];
            }
            gcdDp[i] = count * (count - 1) / 2;
        }

        // Inclusion-Exclusion to get pairs with gcd exactly i
        for (int i = max; i >= 1; i--) {
            for (int j = i * 2; j <= max; j += i) {
                gcdDp[i] -= gcdDp[j];
            }
        }

        // Prefix sums
        for (int i = 1; i <= max; i++) {
            gcdDp[i] += gcdDp[i - 1];
        }

        int[] ans = new int[queries.length];

        for (int i = 0; i < queries.length; i++) {
            ans[i] = binarySearch(gcdDp, max, queries[i] + 1);
        }

        return ans;
    }

    private int binarySearch(long[] prefix, int max, long target) {
        int left = 1, right = max;

        while (left < right) {
            int mid = left + (right - left) / 2;

            if (prefix[mid] < target) {
                left = mid + 1;
            } else {
                right = mid;
            }
        }

        return left;
    }
}
